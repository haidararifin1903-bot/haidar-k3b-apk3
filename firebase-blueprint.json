        "id": { "type": "string" },
        "movement_number": { "type": "string" },
        "container_number": { "type": "string" },
        "origin_location": { "type": "string" },
        "destination_location": { "type": "string" },
        "equipment": { "type": "string" },
        "operator": { "type": "string" },
        "date_time": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "created_at": { "type": "string" }
