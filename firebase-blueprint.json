{
  "entities": {
    "Container": {
      "title": "Container",
      "description": "Peti kemas di terminal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "container_number": { "type": "string" },
        "iso_code": { "type": "string" },
        "size": { "type": "string" },
        "type": { "type": "string" },
        "owner": { "type": "string" },
        "weight": { "type": "number" },
        "tare_weight": { "type": "number" },
        "max_payload": { "type": "number" },
        "status": { "type": "string" },
        "location": { "type": "string" },
        "seal_number": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["container_number", "size", "type", "status", "location"]
    },
    "Vessel": {
      "title": "Vessel",
      "description": "Kapal petikemas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "vessel_name": { "type": "string" },
        "imo": { "type": "string" },
        "call_sign": { "type": "string" },
        "capacity": { "type": "number" },
        "status": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["vessel_name", "imo", "call_sign", "capacity", "status"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Pelanggan atau shipping line",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "company_name": { "type": "string" },
        "contact_person": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "status": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["company_name", "contact_person", "status"]
    },
    "Port": {
      "title": "Port",
      "description": "Pelabuhan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "port_name": { "type": "string" },
        "port_code": { "type": "string" },
        "country": { "type": "string" },
        "status": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["port_name", "port_code", "status"]
    },
    "YardLocation": {
      "title": "YardLocation",
      "description": "Slot penyimpanan di yard terminal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "block": { "type": "string" },
        "row": { "type": "number" },
        "bay": { "type": "number" },
        "tier": { "type": "number" },
        "location_code": { "type": "string" },
        "status": { "type": "string" },
        "container_number": { "type": "string" },
        "max_weight": { "type": "number" },
        "created_at": { "type": "string" }
      },
      "required": ["block", "row", "bay", "tier", "location_code", "status"]
    },
    "ContainerType": {
      "title": "ContainerType",
      "description": "Master tipe kontainer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "size": { "type": "string" },
        "description": { "type": "string" },
        "is_dangerous_goods": { "type": "boolean" },
        "is_reefer": { "type": "boolean" }
      },
      "required": ["code", "name", "size"]
    },
    "GateInTransaction": {
      "title": "GateInTransaction",
