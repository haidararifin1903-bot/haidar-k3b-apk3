      "title": "DeliveryOrder",
      "description": "Delivery Order rilis kargo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "do_number": { "type": "string" },
        "customer_id": { "type": "string" },
        "customer_name": { "type": "string" },
        "container_number": { "type": "string" },
        "destination": { "type": "string" },
        "truck_number": { "type": "string" },
        "driver": { "type": "string" },
        "date": { "type": "string" },
