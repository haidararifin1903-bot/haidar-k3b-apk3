        "condition": { "type": "string" },
        "seal_number": { "type": "string" },
        "destination": { "type": "string" },
        "status": { "type": "string" },
        "assigned_yard_location": { "type": "string" },
        "notes": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["transaction_number", "container_number", "truck_number", "driver", "date_time", "status"]
    },
    "GateOutTransaction": {
      "title": "GateOutTransaction",
      "description": "Transaksi keluar gerbang terminal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "transaction_number": { "type": "string" },
        "container_number": { "type": "string" },
        "truck_number": { "type": "string" },
        "driver": { "type": "string" },
        "date_time": { "type": "string" },
        "destination": { "type": "string" },
        "do_number": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["transaction_number", "container_number", "truck_number", "driver", "date_time", "status"]
    },
