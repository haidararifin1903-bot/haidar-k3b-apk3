        "created_at": { "type": "string" }
      },
      "required": ["do_number", "customer_name", "container_number", "status"]
    }
  },
  "firestore": {
    "/containers/{containerId}": {
      "entity": "Container",
      "description": "Koleksi data master dan status terkini peti kemas"
    },
    "/vessels/{vesselId}": {
      "entity": "Vessel",
      "description": "Koleksi data kapal"
    },
    "/customers/{customerId}": {
      "entity": "Customer",
      "description": "Koleksi data pelanggan dan consignee"
    },
    "/ports/{portId}": {
      "entity": "Port",
      "description": "Koleksi data pelabuhan"
    },
    "/yard_locations/{locationId}": {
      "entity": "YardLocation",
      "description": "Koleksi status dan peta slot penumpukan yard"
    },
    "/container_types/{typeId}": {
      "entity": "ContainerType",
      "description": "Koleksi tipe ISO kontainer"
    },
    "/gate_in_transactions/{transactionId}": {
      "entity": "GateInTransaction",
      "description": "Log transaksi Gate In"
    },
    "/gate_out_transactions/{transactionId}": {
      "entity": "GateOutTransaction",
      "description": "Log transaksi Gate Out"
    },
    "/yard_movements/{movementId}": {
      "entity": "YardMovementTransaction",
      "description": "Log mutasi penataan yard"
    },
    "/loading_operations/{operationId}": {
      "entity": "LoadingOperation",
      "description": "Log muat kontainer ke kapal"
    },
    "/unloading_operations/{operationId}": {
      "entity": "UnloadingOperation",
      "description": "Log bongkar kontainer dari kapal"
    },
    "/delivery_orders/{doId}": {
      "entity": "DeliveryOrder",
      "description": "Koleksi Delivery Order"
    }
  }
}
